# ── Backend (.env in /backend) ────────────────────────────────────────────────

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ecommerce

# JWT — change this to a long random string in any real environment
JWT_SECRET=supersecretjwtkey_changeme_in_production
JWT_EXPIRES_IN=7d

# Backend port (NestJS)
PORT=3001

# Stripe secret key (test mode only — never use live keys)
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_KEY

# ── Frontend (.env.local in /frontend) ────────────────────────────────────────

# Points to the NestJS API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Stripe publishable key (test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_TEST_KEY

# Google OAuth (optional — Google Sign-In button is hidden when not set)
# Create credentials at: https://console.cloud.google.com/ → APIs & Services → Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
