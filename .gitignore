# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Environment variables ────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# keep .env.example committed

# ─── Next.js (frontend) ───────────────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/

# ─── NestJS (backend) ────────────────────────────────────────────────────────
backend/dist/
backend/build/
# Uploaded product images — keep the folder (tracked via .gitkeep) but not the files
backend/uploads/products/*
!backend/uploads/products/.gitkeep

# ─── Prisma ──────────────────────────────────────────────────────────────────
# keep prisma/migrations/ committed — they are the migration history
prisma/migrations/dev.db
*.db
*.db-journal
backend/prisma/generated/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Testing ─────────────────────────────────────────────────────────────────
coverage/
backend/coverage/
frontend/coverage/
.nyc_output/

# ─── Docker ──────────────────────────────────────────────────────────────────
# docker-compose.override.yml is intentionally not ignored

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
backend/*.tsbuildinfo
frontend/*.tsbuildinfo

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Editor ──────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Misc ────────────────────────────────────────────────────────────────────
.turbo/
.cache/
tmp/
temp/
